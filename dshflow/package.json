{
  "name": "dshflow",
  "version": "0.0.1",
  "description": "DeepSeek Harness plugin: render the live Cordis plugin tree as an interactive flow diagram.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "flow",
    "logicflow",
    "vue"
  ],
  "type": "module",
  "main": "plugin/index.mjs",
  "types": "plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./plugin/index.d.ts",
      "default": "./plugin/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "plugin",
    "web",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash ./build.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
